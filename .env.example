# =============================================================================
# Premier Hub ML Service - Plantilla de variables de entorno
#
# Copia este archivo a .env y rellena los valores reales:
#     cp .env.example .env
#
# .env esta en .gitignore y NUNCA debe subirse al repositorio.
# Este archivo (.env.example) solo contiene PLACEHOLDERS, nunca credenciales reales.
#
# Nota: el servicio en runtime (api.py) NO necesita variables de entorno.
# Estas variables solo las usan los scripts de generacion de datos en scripts/.
# =============================================================================

# --- API-Football (api-sports v3) --------------------------------------------
# Clave de la API de API-Football. Obligatoria para:
#   - scripts/calibrate_ratings.py    (recalibra club_ratings.json)
#   - scripts/find_iconic_fixtures.py (genera data/iconic_matches.json)
# Consiguela en https://www.api-football.com/ (dashboard -> API key).
APIFOOTBALL_KEY=tu_api_key_de_api_football

# --- Kaggle ------------------------------------------------------------------
# Credenciales de Kaggle, usadas por kagglehub en:
#   - scripts/prepare_dataset.py (descarga el dataset davidcariboo/player-scores)
# Alternativa a ~/.kaggle/kaggle.json. Generalas en
# https://www.kaggle.com/settings -> Account -> "Create New API Token".
KAGGLE_USERNAME=tu_usuario_de_kaggle
KAGGLE_KEY=tu_api_key_de_kaggle
